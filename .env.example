# Copy to .env and fill in real values. Every value below is a fake placeholder
# showing the expected shape — the app will not run until you replace them.
# Replit-injected vars (REPL_ID, REPLIT_DOMAINS, REPLIT_DEV_DOMAIN) are not listed.

# --- AI Providers ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_DIRECT_KEY=
PERPLEXITY_API_KEY=
# DataForSEO HTTP Basic authentication
DATAFORSEO_API_USERNAME=
DATAFORSEO_API_PASSWORD=
# Optional — only used by server/test-llm-apis.ts
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# --- Fake AI (zero-token stress-test mode) ---
# When FAKE_AI=1, all AI provider calls are replaced by an artificial async
# delay plus schema-valid synthetic responses (see docs/09-fake-ai-stress-mode.md).
# No API keys required, no tokens spent, no usage rows logged.
# FAKE_AI=1
# Milliseconds of artificial latency per faked AI call (0 for max throughput)
# FAKE_AI_DELAY_MS=120
# Optional latency range (both must be set): FAKE_AI_DELAY_MIN_MS=20
# FAKE_AI_DELAY_MAX_MS=200
# Optional chaos: fraction (0..1) of fake calls that throw a transient error
# FAKE_AI_ERROR_RATE=0

# --- LinkedIn OAuth ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional — defaults to https://aeostars.com/api/auth/linkedin/callback
LINKEDIN_CALLBACK_URL=

# --- Lift OS ---
LIFT_OS_API_KEY=

# --- Database ---
DATABASE_URL=

# --- Email ---
RESEND_API_KEY=

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" to fail hard instead of degrading when Stripe is misconfigured
STRIPE_STRICT_MODE=false

# --- Google ---
GOOGLE_PAGESPEED_API_KEY=

# --- App ---
# Generate with: openssl rand -base64 64
SESSION_SECRET=
APP_URL=
# Used only if the live USD->GBP rate (system_config, auto-fetched from
# frankfurter.app) is unavailable
USD_GBP_RATE_FALLBACK=0.79
PORT=5555
NODE_ENV=development
# Optional — redirect all other hosts to this one in production
CANONICAL_REDIRECT_DOMAIN=

# Default free trial length and public marketing duration. Per-account trial end
# dates are persisted at signup and do not change when this value changes. The
# client bundle bakes this value into marketing copy, so copy changes need a build.
TRIAL_DAYS=30
